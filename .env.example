# ============================================================
# AI Sports Video Analyser - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Gemini API (Required for AI Feedback) ----
# Get your free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Gemini Model Selection ----
GEMINI_MODEL=gemini-1.5-flash

# ---- App Settings ----
APP_DEBUG=false
MAX_UPLOAD_SIZE_MB=500

# ---- Processing Settings ----
# Options: fast, balanced, detailed
DEFAULT_PROCESSING_MODE=balanced
DEFAULT_DETECTION_CONFIDENCE=0.5
DEFAULT_SPORT=football

# ---- Storage Settings ----
DATA_INPUT_DIR=data/input
DATA_OUTPUT_DIR=data/output
DATA_TEMP_DIR=data/temp

# ---- Cleanup Settings ----
AUTO_CLEANUP_TEMP=true
KEEP_ANNOTATED_VIDEO=true

# ---- GPU Settings ----
# Set to true to force CPU even if GPU available
FORCE_CPU=false
